    <xacro:macro name="armada_ee_connector_adapter" params="prefix parent *origin" >
        <joint name="flange_ee_connector_adapter_joint" type="fixed">
            <parent link="${parent}" />
            <child link="${prefix}base_link" />
            <xacro:insert_block name="origin" />
        </joint>
        <link name="${prefix}base_link">
            <visual>
                <geometry>
                    <cylinder radius="0.0375" length="0.017"/>
                </geometry>
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="0.0375" length="0.017"/>
                </geometry>
            </collision>
            <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.01"/>
            <inertia 
                ixx="1e-5" ixy="0" ixz="0"
                iyy="1e-5" iyz="0"
                izz="1e-5"/>
            </inertial>
        </link>
    </xacro:macro>
</robot>